{
  "name": "heatmap2d",
  "version": "0.3.1",
  "description": "Two dimensional heatmap rendered on HTML5 canvas",
  "type": "module",
  "unpkg": "dist/heatmap2d.min.js",
  "jsdelivr": "dist/heatmap2d.min.js",
  "main": "dist/heatmap2d.mjs",
  "module": "dist/heatmap2d.mjs",
  "types": "src/index.d.ts",
  "exports": {
    "types": "./dist/heatmap2d.d.ts",
    "umd": "./dist/heatmap2d.min.js",
    "default": "./dist/heatmap2d.mjs"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vasturiano/heatmap2d.git"
  },
  "homepage": "https://github.com/vasturiano/heatmap2d",
  "keywords": [
    "2d",
    "heatmap",
    "canvas",
    "blur",
    "kernel density",
    "gaussian"
  ],
  "author": {
    "name": "Vasco Asturiano",
    "url": "https://github.com/vasturiano"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/vasturiano/heatmap2d/issues"
  },
  "scripts": {
    "build": "rimraf dist && rollup -c",
    "dev": "rollup -w -c rollup.config.dev.js",
    "prepare": "npm run build"
  },
  "files": [
    "dist/**/*",
    "example/**/*",
    "src/**/*"
  ],
  "dependencies": {
    "accessor-fn": "1",
    "d3-array": "3",
    "d3-color": "3",
    "d3-scale": "1 - 4",
    "d3-scale-chromatic": "3",
    "kapsule": "^1.16"
  },
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@babel/preset-env": "^8.0.7",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@typescript/typescript6": "^6.0.2",
    "rimraf": "^6.1.3",
    "rollup": "^4.65.1",
    "rollup-plugin-dts": "^6.5.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=12"
  }
}
